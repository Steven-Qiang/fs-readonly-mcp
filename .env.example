# 监听
MCP_HOST=0.0.0.0
MCP_PORT=7801

# 鉴权：留空 = 不校验（启动会告警，生产务必配）
MCP_TOKEN=

# 可见范围：逗号分隔的绝对路径。不配这一行 = 整个文件系统可读（默认 /）
# 想给项目起别名就用 别名=/绝对路径，例如：
#   MCP_ROOTS=app-a=/srv/app-a,app-b=/srv/app-b,web=/srv/web-logs
# 只想放开部分目录（更稳）：
#   MCP_ROOTS=/srv/app-a/logs,/srv/web-logs
# 留空这一行同样是"全盘可读"
MCP_ROOTS=

# 输出与耗时
MCP_MAX_TEXT_CHARS=64000
MCP_CALL_TIMEOUT_MS=60000

# 遍历时跳过的目录名（逗号分隔）
MCP_IGNORE_DIRS=node_modules,.git,.svn,.hg,vendor,.cache

# 审计日志（NDJSON，每行一次调用），留空不写。全盘可读时建议配上
MCP_AUDIT_LOG=
